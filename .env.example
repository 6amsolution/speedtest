# Public URL of the site (used for canonical / Open Graph URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional JSON array of extra test servers (see README). Rebuild after changing.
# SPEEDTEST_SERVERS=[{"name":"Frankfurt","pingUrl":"https://fra.example.com/api/speedtest/ping","downloadUrl":"https://fra.example.com/api/speedtest/download?bytes={bytes}","uploadUrl":"https://fra.example.com/api/speedtest/upload"}]

# Set to "false" to hide this deployment's own server when SPEEDTEST_SERVERS is set
# SPEEDTEST_INCLUDE_ORIGIN=true

# How this deployment's own server is labelled in the selector
# SPEEDTEST_ORIGIN_NAME=PulseTest Origin
# SPEEDTEST_ORIGIN_CITY=Frankfurt
# SPEEDTEST_ORIGIN_COUNTRY=Germany
# SPEEDTEST_ORIGIN_REGION=fra1

# Per-request limits for this deployment's API (bytes)
# SPEEDTEST_MAX_DOWNLOAD_BYTES=26214400
# SPEEDTEST_MAX_UPLOAD_BYTES=8388608

# Allow other sites to use this deployment as a remote test server ("*" or an origin)
# SPEEDTEST_CORS_ORIGIN=
